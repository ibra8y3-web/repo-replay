{
  "name": "repo-replay",
  "version": "0.1.0",
  "description": "Turn any git repo's history into a shareable story with chapters at the real turning points.",
  "type": "module",
  "bin": { "repo-replay": "dist/src/cli.js" },
  "main": "dist/src/index.js",
  "files": ["dist/src", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test dist/test/chapters.test.js",
    "start": "node dist/src/cli.js"
  },
  "engines": { "node": ">=18" },
  "keywords": ["git", "history", "visualization", "story", "cli"],
  "license": "MIT",
  "devDependencies": { "typescript": "^5.6.0", "@types/node": "^22.0.0" }
}
